# --- Core ---
APP_NAME=AgentOS
ENV=development
DEBUG=true

# --- Database & Cache ---
DATABASE_URL=postgresql+asyncpg://agentos:agentos@postgres:5432/agentos
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Providers (do not hardcode a provider in code; select via LLM_PROVIDER) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- MCP servers (optional; each server degrades to a labeled stub without these) ---
GITHUB_TOKEN=
DATABASE_URL_SYNC=postgresql://agentos:agentos@postgres:5432/agentos
SEARCH_API_KEY=
SEARCH_API_PROVIDER=tavily
SLACK_WEBHOOK_URL=

# --- Observability ---
LANGSMITH_API_KEY=

# --- Object storage ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
